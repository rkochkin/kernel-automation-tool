# schema.yml
$schema: "http://json-schema.org/draft-07/schema#"
$id: "https://example.com/linux-kernel-build-config.schema.json"
title: "Linux Kernel Build Configuration"
description: "Schema for Linux kernel build configuration file"
type: object

properties:
  kernel:
    type: object
    description: "Kernel source configuration"
    required: ["name", "version", "repository", "branch"]
    properties:
      name:
        type: string
        description: "Kernel name"
        enum: ["linux"]
      version:
        type: string
        description: "Kernel version"
        pattern: "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
      repository:
        type: string
        description: "Git repository URL"
        format: uri
      branch:
        type: string
        description: "Git branch name"
      commit:
        type: string
        description: "Specific commit hash (optional)"
        pattern: "^[a-f0-9]{0,40}$"
        default: ""

  build:
    type: object
    description: "Build configuration"
    required: ["arch", "output_dir", "config_file"]
    properties:
      arch:
        type: string
        description: "Target architecture"
        enum: ["arm64", "x86_64", "arm", "riscv"]
      output_dir:
        type: string
        description: "Output directory for build artifacts"
      config_file:
        type: string
        description: "Kernel configuration file"
        enum: ["defconfig", "config", ".config"]
      make_target:
        type: string
        description: "Make target"
        default: "all"

  device_trees:
    type: array
    description: "List of device tree files to compile"
    items:
      type: string
      description: "Device tree source file path"
      pattern: "\\.dts$"

  modules:
    type: object
    description: "Kernel modules configuration"
    required: ["enabled"]
    properties:
      enabled:
        type: boolean
        description: "Whether to build kernel modules"
      install_path:
        type: string
        description: "Installation path for modules"
        default: "./output/modules"

  patches:
    type: array
    description: "List of patches to apply"
    items:
      type: string
      description: "Patch file path"
      pattern: "\\.patch$"

  environment:
    type: object
    description: "Build environment variables"
    properties:
      make_jobs:
        type: integer
        description: "Number of parallel jobs for make"
        minimum: 1
        maximum: 32
        default: 1
      cc:
        type: string
        description: "C compiler to use"
      cross_compile:
        type: string
        description: "Cross-compile prefix"
        pattern: ".+-$"

required: ["kernel", "build"]
additionalProperties: false

# Definitions for common patterns
definitions:
  git_repository:
    type: string
    pattern: "^https?://.+\\.git$"
    
  architecture:
    type: string
    enum: ["arm64", "x86_64", "arm", "riscv", "powerpc"]
